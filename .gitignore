*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- Node / frontend ---
node_modules/
frontend/dist/
coverage/
*.tsbuildinfo

# --- Editors / OS ---
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
