# OpsPilot environment template — copy to .env and fill in. NEVER commit .env.
# All API keys and tokens live outside the repository (spec 16.2 / SEC-07).

# Kubernetes context used by the lab (default: kind-opspilot)
KUBECONFIG=

# LLM provider configuration (choose at S5, after the model feasibility test;
# spec 11.5 + 20.2 - no paid provider is a mandatory dependency of the MVP)
OPSPILOT_LLM_PROVIDER=          # e.g. ollama | openai-compatible (to be validated, not yet chosen)
OPSPILOT_LLM_MODEL=             # model id frozen once selected
OPSPILOT_LLM_API_KEY=           # if an external provider is authorized; empty for local
OPSPILOT_LLM_BASE_URL=

# PostgreSQL (S4/S5)
OPSPILOT_DB_URL=

# Collect path used by lab scripts to write evidence artifacts
OPSPILOT_LAB_OUT_DIR=out
